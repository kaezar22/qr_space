# Copia este archivo como .env.local (local) y carga las mismas variables en Vercel.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave pública (anon / publishable). Solo se usa para escuchar avisos en tiempo real.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (service_role / secret). NUNCA la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña del panel del bar (/bar)
BAR_PASSWORD=cambia-esta-clave
# Texto largo y aleatorio para firmar la sesión del bar
BAR_SESSION_SECRET=pon-aqui-un-texto-largo-y-aleatorio

# Nombre que ven los clientes
NEXT_PUBLIC_BAR_NAME=Mi Bar
